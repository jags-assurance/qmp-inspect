{
  "name": "jags-assurance-project",
  "private": true,
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "dev": "pnpm --filter @jags/web dev",
    "dev:worker": "pnpm --filter @jags/worker dev",
    "build": "pnpm --filter @jags/web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "check:migrations": "node scripts/check-migration-names.mjs",
    "backup:storage": "node scripts/export-storage.mjs",
    "db:push": "npx supabase db push",
    "db:types": "npx supabase gen types typescript --linked > packages/shared-types/src/database.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "puppeteer"
    ],
    "overrides": {
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "uuid@<11.1.1": "11.1.1",
      "ip-address@<=10.7.0": "10.7.1",
      "basic-ftp@<=6.2.0": "6.2.1",
      "source-map-js@<1.2.2": "1.2.2",
      "sharp@<0.35.5": "0.35.5"
    }
  }
}
