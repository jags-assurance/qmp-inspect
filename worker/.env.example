# Copy to .env and fill in with values from `npx supabase status` (local dev) or Railway's
# environment variables (production). Never commit .env.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Error tracking (Sentry) — scaffolded but INACTIVE until set (no Sentry account exists yet). See
# src/index.ts's reportError()/Sentry.init() — a genuine no-op with this left blank.
SENTRY_DSN=
