# Copy to .env.local and fill in with values from `npx supabase status` (local dev) or
# Railway/Vercel's environment variables (deployed). Never commit .env.local.

# Public — safe to expose to the browser (Next.js inlines NEXT_PUBLIC_* at build time). The
# anon key is the ONLY Supabase key this app ever uses; every query still goes through RLS,
# server-side included — see lib/supabase/server.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini AI features (checklist/ITP drafting, report narratives, root-cause suggestions).
# GEMINI_API_KEY is required for any AI feature to work at all.
GEMINI_MODEL_LIGHT=
GEMINI_MODEL_HEAVY=
GEMINI_API_KEY=

# Must be exactly "paid" to allow any real organisation data to reach the AI provider at all —
# see lib/ai/gate.ts. Any other value (including unset) keeps every AI feature gated off, which
# is the correct default for a fresh/local environment: on Google's free tier, submitted content
# may be used for model training, so no real org data may be sent regardless of that org's own
# ai_consent setting.
AI_TIER=
