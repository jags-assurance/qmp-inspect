# Copy to .env.local and fill in with values from `npx supabase status` (local dev) or your
# Supabase project settings (staging/production). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — used by admin server actions (e.g. inviting a user, setting is_jags_staff).
# Bypasses RLS. Never expose to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# AI provider — see lib/ai/provider.ts (Phase 3). Free-tier key for local development only;
# never point a paid/production key at this file. See AI_TIER below.
GEMINI_API_KEY=
AI_TIER=free
# Model names churn fast on Gemini's side — if generation starts failing with a 404
# "model not found" error, list what your key actually has access to:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
# and pick a current one, or use the "-latest" aliases below, which always point at Google's
# current recommended model for that tier and need no maintenance as models are retired.
GEMINI_MODEL_HEAVY=gemini-pro-latest
GEMINI_MODEL_LIGHT=gemini-flash-latest
