# Copy to .env.local and fill in with values from `npx supabase status` (local dev) or your
# Supabase project settings (staging/production). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — used by admin server actions (e.g. inviting a user, setting is_jags_staff) and by
# the email-to-vault webhook below (lib/supabase/service.ts). Bypasses RLS. Never expose to the
# browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# R20b — email-to-vault ingestion (app/api/vault/email-inbound/route.ts). Shared secret an inbound
# -email provider (Postmark inbound parse, etc.) must send back on every webhook call, either as
# an `x-vault-webhook-secret` header, an `Authorization: Bearer <secret>` header, or a `?secret=`
# query param. Leaving this unset makes the endpoint reject every request (fails closed).
VAULT_EMAIL_WEBHOOK_SECRET=

# R20c — cloud folder sync (SharePoint/OneDrive, lib/cloud-sync/gate.ts). From a Microsoft Entra ID
# (Azure AD) app registration granted the Graph Sites.Read.All / Files.Read.All application
# permissions. Left unset, the Cloud Folder Sync settings page shows an honest "not yet connected"
# state instead of attempting a sync that would only fail. See that file's header comment for the
# full integration steps once these exist.
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_TENANT_ID=

# R21 — external construction-document platform connectors (lib/connectors/). None of these have
# real credentials available in this environment; every connector's isConfigured() checks for its
# own set below and returns false until they're genuinely set (and the connector itself is
# implemented against that platform's real API — see each connector file's own comment).
ACONEX_API_KEY=
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=
PROJECTWISE_API_BASE_URL=
PROJECTWISE_API_KEY=

# AI provider — see lib/ai/provider.ts (Phase 3). Free-tier key for local development only;
# never point a paid/production key at this file. See AI_TIER below.
GEMINI_API_KEY=
AI_TIER=free
# Model names churn fast on Gemini's side — if generation starts failing with a 404
# "model not found" error, list what your key actually has access to:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
# and pick a current one, or use the "-latest" aliases below, which always point at Google's
# current recommended model for that tier and need no maintenance as models are retired.
GEMINI_MODEL_HEAVY=gemini-pro-latest
GEMINI_MODEL_LIGHT=gemini-flash-latest

# Error tracking (Sentry) — scaffolded but INACTIVE until these are set (no Sentry account exists
# yet). See instrumentation.ts/instrumentation-client.ts/sentry.*.config.ts — every one of them is a
# genuine no-op with these left blank. NEXT_PUBLIC_SENTRY_DSN reaches the browser bundle; the plain
# SENTRY_DSN covers the server/edge runtimes and is a separate value on purpose (never put a real
# secret in a NEXT_PUBLIC_ var — a DSN itself is safe to expose, but keep the two settings distinct).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Email notification delivery (Resend) — scaffolded but INACTIVE until RESEND_API_KEY is set (no
# Resend account exists yet). See lib/notifications/email.ts/helpers.ts — a genuine no-op with this
# left blank; every in-app notification (sign-off Notify, NCR raised, etc.) still writes its DB row
# regardless, it just never reaches an email inbox until this is configured.
RESEND_API_KEY=
# Must be a domain verified in that Resend account, or sends are rejected.
NOTIFICATIONS_EMAIL_FROM="JAGS Assurance <notifications@jagsassurance.com>"
# Used to build an absolute "Open in JAGS Assurance" link inside the email body.
NEXT_PUBLIC_APP_URL=http://localhost:3000
